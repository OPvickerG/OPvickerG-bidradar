# Copy to .env.local for local development. In the cloud these come from Cloud Run env vars and
# Secret Manager (never commit real values). See CONFIGURATION.md for every option.

# --- required -----------------------------------------------------------------
DATABASE_URL=sqlite:///./bidradar_local.db          # cloud: postgresql://USER:PASSWORD@HOST/DB?sslmode=require (secret)
SESSION_SECRET=change-me-to-a-long-random-string    # secret: openssl rand -hex 32
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=                                 # secret: python3 -m core.passwords
PUBLIC_BASE_URL=http://localhost:8080                # cloud: https://<your Cloud Run URL or domain>
APP_ENV=development                                  # production in the cloud
SECURE_COOKIES=false                                 # true in the cloud (HTTPS)

# --- email (default console = dry-run; nothing is sent) -------------------------
EMAIL_PROVIDER=console                               # console | resend | smtp
EMAIL_FROM=                                          # e.g. "BidRadar <alerts@your-verified-domain>"
RESEND_API_KEY=                                      # secret
RESEND_WEBHOOK_SECRET=                               # secret (whsec_...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=                                       # secret
EMAIL_MAX_ATTEMPTS=5

# --- scanner tuning (defaults are deliberately polite) --------------------------
SCANNER_REQUEST_DELAY=3.0
SCANNER_REQUEST_TIMEOUT=60
SCANNER_MAX_PAGES_PER_TERM=2
SCANNER_BACKFILL_PAGES_PER_TERM=4
SCANNER_MAX_DOCUMENTS_PER_SCAN=40
SCANNER_MAX_REFRESHES_PER_SCAN=40
SCAN_LEASE_MINUTES=25
SOURCE_FAILURE_THRESHOLD=3
EMBEDDING_BACKEND=none                               # none | fastembed

# --- optional -------------------------------------------------------------------
INTERNAL_TASK_TOKEN=                                 # secret; enables POST /internal/scan
GCP_PROJECT=                                         # set by deploy.sh so "Scan now" can start the Cloud Run Job
GCP_REGION=
SCAN_JOB_NAME=
