<!doctype html><html><body style="margin:0;background:#f3f5f8;font-family:Segoe UI,Roboto,Arial,sans-serif;color:#111827">
<table width="100%" cellpadding="0" cellspacing="0" style="background:#f3f5f8;padding:24px 0"><tr><td align="center">
<table width="640" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:10px;overflow:hidden;border:1px solid #e5e7eb">
<tr><td style="background:#0f2a43;color:#fff;padding:18px 24px">
<div style="font-size:12px;letter-spacing:.12em;color:#9fb8d1">OPVICKERG BIDRADAR</div>
<div style="font-size:18px;font-weight:600;margin-top:4px">{{ heading }}</div></td></tr>
{% if change_summary %}<tr><td style="padding:16px 24px 0"><div style="background:#fff7ed;border:1px solid #fed7aa;border-radius:8px;padding:12px 14px;font-size:14px"><b>What changed:</b><br>{{ change_summary|e|replace("\n","<br>") }}</div></td></tr>{% endif %}
<tr><td style="padding:16px 24px">
<div style="font-size:17px;font-weight:600;line-height:1.35">{{ t.title }}</div>
<div style="margin-top:8px"><span style="display:inline-block;background:{{ badge_bg }};color:#fff;border-radius:999px;padding:3px 10px;font-size:12px;font-weight:600">{{ t.relevance_score }}/100 · {{ band }}</span>
<span style="display:inline-block;background:#eef2f7;border-radius:999px;padding:3px 10px;font-size:12px;margin-left:6px">{{ category }}</span></div>
<table cellpadding="0" cellspacing="0" width="100%" style="margin-top:14px;font-size:14px">
{% for k,v in facts %}<tr><td style="padding:6px 0;color:#6b7280;width:180px;vertical-align:top">{{ k }}</td><td style="padding:6px 0;vertical-align:top">{{ v }}</td></tr>{% endfor %}
</table></td></tr>
{% for title, items in sections %}<tr><td style="padding:4px 24px 12px"><div style="font-size:12px;letter-spacing:.08em;color:#0f2a43;font-weight:700;margin-bottom:6px">{{ title }}</div>
{% if items is string %}<div style="font-size:14px;line-height:1.5">{{ items }}</div>{% else %}<ul style="margin:0;padding-left:18px;font-size:14px;line-height:1.5">{% for i in items %}<li>{{ i }}</li>{% else %}<li style="color:#6b7280">Not available</li>{% endfor %}</ul>{% endif %}</td></tr>{% endfor %}
<tr><td style="padding:8px 24px 20px">
{% if links.view %}<a href="{{ links.view }}" style="display:inline-block;background:#0f2a43;color:#fff;text-decoration:none;padding:9px 14px;border-radius:6px;font-size:13px;margin:4px 6px 0 0">View Tender</a>{% endif %}
{% if links.document %}<a href="{{ links.document }}" style="display:inline-block;background:#1f6feb;color:#fff;text-decoration:none;padding:9px 14px;border-radius:6px;font-size:13px;margin:4px 6px 0 0">Download Tender Document</a>{% endif %}
{% if links.corrigenda %}<a href="{{ links.corrigenda }}" style="display:inline-block;background:#eef2f7;color:#111827;text-decoration:none;padding:9px 14px;border-radius:6px;font-size:13px;margin:4px 6px 0 0">View Corrigenda</a>{% endif %}
<a href="{{ links.dashboard }}" style="display:inline-block;background:#eef2f7;color:#111827;text-decoration:none;padding:9px 14px;border-radius:6px;font-size:13px;margin:4px 6px 0 0">Open in BidRadar</a>
</td></tr>
<tr><td style="background:#f8fafc;padding:14px 24px;font-size:12px;color:#6b7280;border-top:1px solid #e5e7eb">OPvickerG BidRadar · Automated Government Tender Intelligence<br>Last verified: {{ verified }} · Data from public government portals; confirm on the official portal before acting.</td></tr>
</table></td></tr></table></body></html>
